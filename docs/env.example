# Copy to .env and replace every placeholder before starting the app.
DATABASE_URL=mysql://sourcebound:sourcebound@localhost:3306/sourcebound_exam
JWT_SECRET=replace-with-a-long-random-secret
APP_NAME=SourceBound Exam
PUBLIC_BASE_URL=http://localhost:3000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-provider-key
OPENAI_MODEL=gpt-4o-mini
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
# Set STORAGE_DRIVER=s3 to use MinIO/AWS S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sourcebound-exam
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret
PORT=3000
